          ],
          "states": [
            "文本冲突",
            "删除 / 修改冲突",
            "外部文件已变化"
          ]
        },
        {
          "id": "F4",
          "title": "操作进行中，继续或中止",
          "kind": "operation",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
