{
  "title": "SuperGit 页面与状态路线图",
  "version": 1,
  "date": "2026-11-11",
  "scope": "本地静态设计稿，未应用到原生客户端；不承诺发布日期。",
  "dimensions": {
    "overview": [
      5840,
