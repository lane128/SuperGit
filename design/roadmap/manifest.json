          ],
          "states": [
            "计划编辑",
            "校验失败",
            "执行前确认"
          ]
        }
      ],
      "edges": [
        [
          "F1",
          "F3",
          "恢复产生冲突"
        ],
        [
          "F3",
          "F4",
          "全部解决后继续"
        ],
        [
          "F5",
          "F4",
