  "stages": {
    "R1": "底层 Git 能力已有，新 UI 待落地",
    "R2": "仓库页签、多语言和完整设置提案",
    "R3": "交互式 Rebase、外部工具后续提案"
  },
  "tracks": [
    {
      "id": "A",
      "name": "仓库入口",
      "claim": "从最近仓库、克隆或初始化进入工作区；失败保留目标和输入。",
      "frames": [
        {
          "id": "A1",
          "title": "最近仓库与空入口",
          "kind": "home",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "最近仓库显示路径、分支与上次打开位置；打开失败不移除记录。",
            "无记录时保留“打开 / 克隆 / 初始化”三个明确入口。"
          ],
          "states": [
            "最近记录",
            "首次启动为空",
            "路径已失效"
          ]
        },
        {
          "id": "A2",
          "title": "克隆目标与新目录",
          "kind": "clone",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "URL 与目标路径分别输入；目标必须是不存在的新目录。",
            "认证交给系统凭据助手 / SSH agent，不在设置中存令牌。"
          ],
          "states": [
            "地址合法",
            "目录已存在",
            "输入不完整"
          ]
        },
        {
          "id": "A3",
          "title": "克隆进行中与取消",
          "kind": "clone-running",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "没有真实进度时显示不定进度；不伪造百分比。",
            "取消后等待进程退出并核对实际结果，不假称已回滚。"
          ],
          "states": [
            "运行中",
            "已请求取消",
            "核对结果"
          ]
        },
        {
          "id": "A4",
          "title": "克隆失败与重试",
          "kind": "clone-error",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "保留原地址、目标路径和错误详情；重试先检查残留目标。",
            "目标目录若已产生，不自动覆盖或删除。"
          ],
          "states": [
            "认证失败",
            "网络失败",
            "目标目录需要检查"
          ]
        },
        {
          "id": "A5",
          "title": "初始化新仓库",
          "kind": "init",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "目标是新目录；初始化成功后进入 B1。",
            "选择父目录再填写名称；失败保留表单。"
          ],
          "states": [
            "目录有效",
            "创建中",
            "失败重试"
          ]
        }
      ],
      "edges": [
        [
          "A1",
          "A2",
          "克隆仓库"
        ],
        [
          "A2",
          "A3",
          "确认新目录"
        ],
        [
          "A3",
          "A4",
          "读取失败"
        ],
        [
          "A4",
          "A3",
          "检查目标后重试"
        ],
        [
          "A1",
          "A5",
          "初始化新仓库"
        ]
      ]
    },
    {
      "id": "B",
      "name": "工作区与提交",
      "claim": "文件、片段、Index 与工作区分开；提交失败保留草稿和暂存内容。",
      "frames": [
        {
          "id": "B1",
          "title": "未暂存 / 已暂存",
          "kind": "workspace",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "选择文件只预览；暂存按钮才更新 Index。",
            "文件级、片段级与行级操作放在差异旁。"
          ],
          "states": [
            "有改动",
            "新文件",
            "二进制仅文件级"
          ]
        },
        {
          "id": "B2",
          "title": "选择片段与部分暂存",
          "kind": "partial",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "当前片段已选 4 行；提交只包含选定部分。",
            "外部变化后旧选择失效，提示重新读取。"
          ],
          "states": [
            "选择行",
            "部分暂存",
            "外部变化拒绝旧补丁"
          ]
        },
        {
          "id": "B3",
          "title": "提交 Index 的明确确认",
          "kind": "commit-confirm",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "展示目标仓库、分支、说明与已暂存路径。",
            "未暂存文件保留；运行真实 hooks。"
          ],
          "states": [
            "目标确认",
            "执行中",
            "取消确认"
          ]
        },
        {
          "id": "B4",
          "title": "Hook 失败，保留草稿",
          "kind": "commit-error",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "错误贴近提交器，草稿和 Index 均保留。",
            "查看原始输出后修正内容，再次提交。"
          ],
          "states": [
            "hook 拒绝",
            "身份未配置",
            "签名失败"
          ]
        },
        {
          "id": "B5",
          "title": "提交成功，保留未暂存改动",
          "kind": "clean",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "显示实际提交 SHA；可直接转到 C1 定位新提交。",
            "若还有未暂存改动，继续保留在文件列表。"
          ],
          "states": [
            "提交成功",
            "仍有未暂存改动",
            "工作区干净"
          ]
        }
      ],
      "edges": [
        [
          "B1",
          "B2",
          "选行并暂存"
        ],
        [
          "B2",
          "B3",
          "提交暂存内容"
        ],
        [
          "B3",
          "B4",
          "hook 拒绝"
        ],
        [
          "B4",
          "B3",
          "修正后重试"
        ],
        [
          "B3",
          "B5",
          "提交成功"
        ]
      ]
    },
    {
      "id": "C",
      "name": "历史、引用与线图",
      "claim": "固定轨道显示真实父关系；过滤缺失的父提交用边界标记，不补造连线。",
      "frames": [
        {
          "id": "C1",
          "title": "固定轨道的历史图",
          "kind": "history",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "主线竖直，跨轨道使用短折线和 4px 小圆角。",
            "颜色与轨道绑定分支身份；节点与提交行严格对齐。"
          ],
          "states": [
            "所有引用",
            "detached HEAD",
            "双圈为合并"
          ]
        },
        {
          "id": "C2",
          "title": "搜索、分页与缺失父级",
          "kind": "history-filter",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "搜索覆盖已载入提交；过滤不会重分配轨道。",
            "未载入 / 被过滤父级显示短虚线和边界标记。"
          ],
          "states": [
            "搜索无结果",
            "追加中",
            "追加失败保留已有列表"
          ]
        },
        {
          "id": "C3",
          "title": "完整提交与第一父级 Diff",
          "kind": "commit-detail",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "完整说明、作者、SHA、父提交与文件详情分层。",
            "合并提交明确与第一父提交比较，父级可跳转。"
          ],
          "states": [
            "说明加载中",
            "文件读取失败",
            "空差异成功"
          ]
        },
        {
          "id": "C4",
          "title": "标签目标不在已载入历史",
          "kind": "tag-detail",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "按不可变 SHA 打开旧目标，不往线图插入伪造提交。",
            "对象 SHA、最终目标 SHA 与类型分别显示。"
          ],
          "states": [
            "轻量 / 附注 / 符号引用",
            "非提交目标",
            "失败后只读重试"
          ]
        },
        {
          "id": "C5",
          "title": "分支与具体对象确认",
          "kind": "branches",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "切换前检查工作区；删除确认显示名称与目标提交。",
            "被 worktree 占用、当前分支、未合并等限制明确显示。"
          ],
          "states": [
            "当前分支",
            "被 worktree 占用",
            "安全删除被拒绝"
          ]
        }
      ],
      "edges": [
        [
          "C1",
          "C2",
          "搜索已加载内容"
        ],
        [
          "C1",
          "C3",
          "选择提交"
        ],
        [
          "C1",
          "C4",
          "打开标签目标"
        ],
        [
          "C3",
          "C5",
          "从此创建分支"
        ]
      ]
    },
    {
      "id": "D",
      "name": "子模块打开与返回",
      "claim": "单击预览，双击在同一窗口打开仓库页签；父仓库上下文独立保留。",
      "frames": [
        {
          "id": "D1",
          "title": "父仓库的子模块详情",
          "kind": "modules",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "父 HEAD、Index、当前检出分开显示。",
            "单击只选中；双击进入已初始化子模块。"
          ],
          "states": [
            "指针前进",
            "内部 dirty",
            "三指针一致"
          ]
        },
        {
          "id": "D2",
          "title": "双击后：独立仓库页签",
          "kind": "child",
          "stage": "R2",
          "capability": "新增提案",
          "notes": [
            "同窗口新增 core 页签；已有该仓库页签时直接聚焦。",
            "面包屑 atlas / modules/core；所有 Git 动作只针对 core。"
          ],
          "states": [
            "打开中",
            "已有页签复用",
            "嵌套子模块继续面包屑"
          ]
        },
        {
          "id": "D3",
          "title": "子模块提交后回到父仓库",
          "kind": "parent-return",
          "stage": "R2",
          "capability": "新增提案",
          "notes": [
            "恢复父仓库的选择、滚动与提交草稿，并刷新子模块状态。",
            "子模块提交改变当前检出；父 Index 不会自动更新。"
          ],
          "states": [
            "当前版本前进",
            "父 Index 尚未暂存",
            "显式暂存指针"
          ]
        },
        {
          "id": "D4",
          "title": "双击未初始化子模块",
          "kind": "module-init",
          "stage": "R1",
          "capability": "已有初始化能力",
          "notes": [
            "先确认路径和 Index 目标版本，再初始化。",
            "这一步不打开空仓库页签；取消仍留在父仓库。"
          ],
          "states": [
            "确认初始化",
            "取消",
            "成功后进入 D2"
          ]
        },
        {
          "id": "D5",
          "title": "初始化失败仍保留父仓库",
          "kind": "module-error",
          "stage": "R1",
          "capability": "已有错误与取消能力",
          "notes": [
            "显示初始化失败原因和目标；保留父仓库及子模块选择。",
            "可检查认证后重试，取消只请求停止并刷新实际结果。"
          ],
          "states": [
            "初始化中",
            "取消中",
            "失败后重试"
          ]
        }
      ],
      "edges": [
        [
          "D1",
          "D2",
          "双击已初始化项"
        ],
        [
          "D2",
          "D3",
          "子模块提交后返回"
        ],
        [
          "D1",
          "D4",
          "双击未初始化项"
        ],
        [
          "D4",
          "D5",
          "初始化失败"
        ],
        [
          "D5",
          "D4",
          "检查原因后重试"
        ]
      ]
    },
    {
      "id": "E",
      "name": "远端与同步",
      "claim": "确认源与目标，再写入远端；取消和失败都要显示实际结果。",
      "frames": [
        {
          "id": "E1",
          "title": "远端配置与跟踪分支",
          "kind": "remotes",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "Fetch / Push 地址与跟踪分支分开显示。",
            "认证沿用系统助手；界面不收集密钥或令牌。"
          ],
          "states": [
            "已配置",
            "无远端",
            "多地址暂不支持"
          ]
        },
        {
          "id": "E2",
          "title": "Fetch 运行与取消",
          "kind": "fetch-running",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "显示仓库、远端、任务日志与取消状态。",
            "失败保留有效工作区数据；不假称远端操作已撤销。"
          ],
          "states": [
            "运行中",
            "请求取消",
            "退出后刷新"
          ]
        },
        {
          "id": "E3",
          "title": "Push 的源与远端目标",
          "kind": "push-confirm",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "确认远端、源分支、目标分支与待推送提交。",
            "首次推送明确显示是否设置 upstream。"
          ],
          "states": [
            "目标确认",
            "执行中",
            "失败重试"
          ]
        },
        {
          "id": "E4",
          "title": "子模块检查阻止父仓库推送",
          "kind": "push-blocked",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "指出具体子模块和不可达提交；跳到 D1 检查。",
            "先发布并核对子模块，再发布父仓库指针。"
          ],
          "states": [
            "子模块未初始化",
            "远端提交不可达",
            "检查信息未更新"
          ]
        },
        {
          "id": "E5",
          "title": "Pull 分叉，明确下一步",
          "kind": "pull-diverged",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "仅快进拉取受阻；由用户选择 Merge 或普通 Rebase。",
            "不提供强制覆盖开关；进入 F3 / F4 处理整合。"
          ],
          "states": [
            "可快进",
            "历史分叉",
            "本地改动受阻"
          ]
        }
      ],
      "edges": [
        [
          "E1",
          "E2",
          "Fetch"
        ],
        [
          "E1",
          "E3",
          "Push"
        ],
        [
          "E3",
          "E4",
          "子模块检查未通过"
        ],
        [
          "E1",
          "E5",
          "Pull 发现分叉"
        ]
      ]
    },
    {
      "id": "F",
      "name": "Stash、Worktree 与整合",
      "claim": "恢复、更换工作区和解决冲突都保留明确对象身份与退出路径。",
      "frames": [
        {
          "id": "F1",
          "title": "Stash 的只读预览与恢复",
          "kind": "stash",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "按 SHA 固定条目；序号变化不误选其他条目。",
            "恢复前检查工作区，冲突时保留 Stash。"
          ],
          "states": [
            "预览加载 / 失败 / 空成功",
            "应用",
            "应用并移除"
          ]
        },
        {
          "id": "F2",
          "title": "Worktree 创建与安全移除",
          "kind": "worktrees",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "各工作区显示路径、分支、锁定和占用状态。",
            "移除前检查 dirty、忽略文件与当前工作区。"
          ],
          "states": [
            "创建新路径",
            "已锁定",
            "移除受阻"
          ]
        },
        {
          "id": "F3",
          "title": "文本冲突与最终结果",
          "kind": "conflict",
          "stage": "R1",
          "capability": "已有能力",
          "notes": [
            "Base / Ours / Theirs 来源明确；编辑最终结果。",
