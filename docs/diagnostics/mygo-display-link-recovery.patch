diff --git a/internal/darwin/stalled_display_link_test.go b/internal/darwin/stalled_display_link_test.go
new file mode 100644
--- /dev/null
+++ b/internal/darwin/stalled_display_link_test.go
@@ -0,0 +1,26 @@
+//go:build darwin
+
+package darwin
+
+import (
+	"testing"
+	"time"
+)
+
+// A display link can remain unpaused without delivering another callback.
+// A later state change must still draw instead of trusting linkRunning forever.
+func TestRequestedFrameRecoversWhenRunningDisplayLinkStopsTicking(t *testing.T) {
+	load()
+	h := &frameHandler{}
+	b := &Backend{bySurface: map[id]*surface{}}
+	s := &surface{
+		w: &window{b: b, h: h}, view: 1, link: 1,
+		linkRunning: true, lastFrame: time.Now().Add(-time.Second),
+	}
+	b.bySurface[s.view] = s
+	s.RequestFrame()
+	drainMainQueue()
+	if len(h.paced) != 1 || h.paced[0] {
+		t.Fatalf("stalled display link: frames %v, want one unpaced recovery frame", h.paced)
+	}
+}
